# =============================================================================
# NEXUS Flow AI — Git Ignore Configuration
# =============================================================================

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Python Packaging & Distribution
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
ENV/
env/

# Environment Variables & Secrets (NEVER COMMIT)
.env
.env.local
.env.*.local
*.pem
*.key
id_rsa
id_ed25519*

# Local Databases & Storage
*.sqlite
*.sqlite3
*.db
nexus_flow.db

# Application Logs & Diagnostics
logs/
*.log
errors.log
dead_letter.csv

# Testing & Code Coverage
.coverage
.pytest_cache/
htmlcov/
.tox/
.nox/

# Temporary Uploads & Mock Exports
uploads/
temp/
scratch/
exports/*.csv
!exports/.gitkeep

# IDE & Operating System Files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
ehthumbs.db

# Ensure documentation & visual assets are always tracked
!assets/
!assets/**
!docs/
!docs/**
