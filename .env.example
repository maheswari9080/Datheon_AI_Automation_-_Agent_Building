# ==========================================
# NEXUS Flow AI — Environment Configuration
# ==========================================

# Application Environment (development, testing, production)
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
SECRET_KEY=nexus_flow_super_secure_secret_key_change_in_production_32chars

# Operational Mode
# Set to 'true' to use live external APIs; 'false' uses realistic resilient mock adapters
LIVE_MODE=false

# Database Configuration
# Local SQLite default: sqlite:///./nexus_flow.db
# PostgreSQL example: postgresql://nexus_user:nexus_pass@localhost:5432/nexus_flow
DATABASE_URL=sqlite:///./nexus_flow.db

# OpenAI API Integration
OPENAI_API_KEY=sk-placeholder-openai-api-key
OPENAI_MODEL=gpt-4o
OPENAI_VISION_MODEL=gpt-4o

# Airtable Integration
AIRTABLE_API_KEY=pat-placeholder-airtable-pat
AIRTABLE_BASE_ID=app-placeholder-base-id
AIRTABLE_LEADS_TABLE=Leads
AIRTABLE_PROJECTS_TABLE=Projects

# Slack Integration
SLACK_BOT_TOKEN=xoxb-placeholder-slack-token
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/PLACEHOLDER/WEBHOOK/URL
SLACK_DEFAULT_CHANNEL=#ops-alerts
SLACK_SALES_CHANNEL=#sales-leads
SLACK_SUPPORT_CHANNEL=#support-triage

# Stripe Integration
STRIPE_SECRET_KEY=sk_test_placeholder_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_webhook_signing_secret

# Google Sheets Integration
GOOGLE_SHEETS_CREDENTIALS_JSON=
GOOGLE_SHEETS_SPREADSHEET_ID=spreadsheet_id_placeholder

# Email Integration (Gmail / Outlook)
EMAIL_PROVIDER=mock
EMAIL_INGEST_IMAP_HOST=imap.example.com
EMAIL_INGEST_USER=support@example.com
EMAIL_INGEST_PASSWORD=placeholder_app_password
EMAIL_DRAFT_ONLY=true

# Performance SLAs
LEAD_SLA_MAX_SECONDS=10.0
INVOICE_TOLERANCE_CENTS=1
